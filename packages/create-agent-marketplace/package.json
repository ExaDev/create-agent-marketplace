{
  "name": "create-agent-marketplace",
  "version": "1.3.0",
  "description": "Create an agent marketplace (Claude Code plugins, agent skills or both) from the ExaDev template.",
  "keywords": [
    "create",
    "initializer",
    "claude-code",
    "plugin-marketplace",
    "agent-skills"
  ],
  "license": "MIT",
  "author": "Joseph Mearman <joseph@mearman.co.uk>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExaDev/create-agent-marketplace.git",
    "directory": "packages/create-agent-marketplace"
  },
  "homepage": "https://github.com/ExaDev/create-agent-marketplace#readme",
  "bugs": {
    "url": "https://github.com/ExaDev/create-agent-marketplace/issues"
  },
  "type": "module",
  "bin": {
    "create-agent-marketplace": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1"
  }
}
