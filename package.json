{
  "name": "create-agent-marketplace-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"packages/*/src/**/*.test.ts\"",
    "build": "pnpm --filter create-agent-marketplace run build",
    "lint:commits": "commitlint",
    "release": "semantic-release-workspace release --config release-workspace.config.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@exadev/semantic-release-workspace": "3.1.25",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "26.6.4",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "semantic-release": "25.0.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
